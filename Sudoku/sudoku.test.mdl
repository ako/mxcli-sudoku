-- =====================================================================
-- Sudoku — microflow tests
-- =====================================================================
-- Run with the Docker-free local runner:
--
--   mxcli test sudoku.test.mdl -p "$PWD/Sudoku.mpr" --local
--
-- The path must be ABSOLUTE — a relative -p is handed to mxbuild unchanged
-- and fails with "the project file path should be an absolute path"
-- (FINDINGS #41). --local boots mxcli's own runtime on ports 8081/8091 with
-- its own 'sudoku_test' database, so a warm 'run --local' loop can keep
-- serving on 8080 while these run.
--
-- These cover the grid engine, which is the part with no UI to check it and
-- the part that carries the real algorithmic risk. The board is generated
-- randomly and unseeded, so the assertions are properties that must hold for
-- every deal rather than fixed expected output.
-- =====================================================================

/**
 * The seed grid is shuffled but must stay a complete, valid solution — every
 * square filled, so no '0' survives anywhere in it.
 *
 * @test SUB_ShuffleSolution returns a complete 81-character grid
 * @expect length($result) = 81
 */
$result = CALL MICROFLOW Sudoku.SUB_ShuffleSolution();
/

/**
 * find() returns -1 when the needle is absent, so this asserts the shuffled
 * solution has no empty square left in it.
 *
 * @test SUB_ShuffleSolution leaves no empty square
 * @expect find($result, '0') < 0
 */
$result = CALL MICROFLOW Sudoku.SUB_ShuffleSolution();
/

/**
 * The solver is idempotent on a finished board: nothing is forced because
 * nothing is missing, so it must hand the grid back untouched. This is the
 * one case with a fixed expected value, which makes it a useful canary for
 * the string-splicing arithmetic.
 *
 * @test ACT_SolveGrid returns a solved grid unchanged
 * @expect $result = '534678912672195348198342567859761423426853791713924856961537284287419635345286179'
 */
$result = CALL MICROFLOW Sudoku.ACT_SolveGrid(
  Grid = '534678912672195348198342567859761423426853791713924856961537284287419635345286179',
  Diagonal = false,
  Regions = ''
);
/

/**
 * A single blank square has exactly one candidate, so forced logic alone must
 * fill it — the weakest possible demand on the solver, and the one that would
 * break first if the peer scan regressed.
 *
 * @test ACT_SolveGrid fills a single forced square
 * @expect $result = '534678912672195348198342567859761423426853791713924856961537284287419635345286179'
 */
$result = CALL MICROFLOW Sudoku.ACT_SolveGrid(
  Grid = '034678912672195348198342567859761423426853791713924856961537284287419635345286179',
  Diagonal = false,
  Regions = ''
);
/

/**
 * Blanking must actually blank: the result stays 81 characters and now
 * contains empty squares.
 *
 * @test SUB_BlankSquares keeps the grid 81 characters long
 * @expect length($result) = 81
 */
$result = CALL MICROFLOW Sudoku.SUB_BlankSquares(
  Solution = '534678912672195348198342567859761423426853791713924856961537284287419635345286179',
  TargetGivens = 40
);
/

/**
 * @test SUB_BlankSquares actually removes squares
 * @expect find($result, '0') >= 0
 */
$result = CALL MICROFLOW Sudoku.SUB_BlankSquares(
  Solution = '534678912672195348198342567859761423426853791713924856961537284287419635345286179',
  TargetGivens = 40
);
/

/**
 * Repair hands squares back until forced logic can finish the board, so its
 * output must still be a well-formed 81-character grid.
 *
 * @test SUB_RepairToSolvable returns an 81-character grid
 * @expect length($result) = 81
 */
$result = CALL MICROFLOW Sudoku.SUB_RepairToSolvable(
  Solution = '534678912672195348198342567859761423426853791713924856961537284287419635345286179',
  Puzzle = '000678912672195348198342567859761423426853791713924856961537284287419635345286179',
  TargetGivens = 40,
  Diagonal = false,
  Regions = ''
);
/

-- =====================================================================
-- Sudoku X — the diagonal variant
-- =====================================================================
-- The fixture is the seed grid with four squares blanked: (1,4) (1,5) (5,4)
-- (5,5). Those four form a swap rectangle — exchanging the two values
-- diagonally leaves every row, column and box still valid, so classic logic
-- has two completions and cannot choose. One of the four sits on the main
-- diagonal, and the diagonal rule rejects the swapped grid, which is what
-- makes this pair of tests a real discriminator rather than two spellings of
-- the same assertion.

/**
 * @test the classic solver cannot finish a board that needs the diagonal rule
 * @expect find($result, '0') >= 0
 */
$result = CALL MICROFLOW Sudoku.ACT_SolveGrid(
  Grid = '345721698869300271721986453416872539578693124932100867283469715157238946694517382',
  Diagonal = false,
  Regions = ''
);
/

/**
 * @test the diagonal solver finishes the same board
 * @expect $result = '345721698869354271721986453416872539578693124932145867283469715157238946694517382'
 */
$result = CALL MICROFLOW Sudoku.ACT_SolveGrid(
  Grid = '345721698869300271721986453416872539578693124932100867283469715157238946694517382',
  Diagonal = true,
  Regions = ''
);
/

/**
 * The generator cannot reuse the classic band shuffle, which preserves boxes
 * but scrambles the diagonals. This asserts the shape of what it returns.
 *
 * @test SUB_ShuffleSolutionX returns a complete 81-character grid
 * @expect length($result) = 81
 */
$result = CALL MICROFLOW Sudoku.SUB_ShuffleSolutionX();
/

/**
 * @test SUB_ShuffleSolutionX leaves no empty square
 * @expect find($result, '0') < 0
 */
$result = CALL MICROFLOW Sudoku.SUB_ShuffleSolutionX();
/

/**
 * A grid that is already a valid Sudoku X has nothing left to force, so the
 * diagonal solver must hand it back untouched — the canary for the two extra
 * units being wired in without disturbing the existing 27.
 *
 * @test the diagonal solver returns a solved X grid unchanged
 * @expect $result = '345721698869354271721986453416872539578693124932145867283469715157238946694517382'
 */
$result = CALL MICROFLOW Sudoku.ACT_SolveGrid(
  Grid = '345721698869354271721986453416872539578693124932145867283469715157238946694517382',
  Diagonal = true,
  Regions = ''
);
/

-- =====================================================================
-- Jigsaw — irregular regions instead of 3x3 boxes
-- =====================================================================
-- The fixture blanks one entire region (nine squares). The classic box rule
-- knows nothing about that shape, so it stalls; the region rule rebuilds the
-- board exactly. Same construction as the Sudoku X pair — two runs of the same
-- solver over the same grid, differing only in the rule set.

/**
 * @test the box solver cannot finish a board whose regions are irregular
 * @expect find($result, '0') >= 0
 */
$result = CALL MICROFLOW Sudoku.ACT_SolveGrid(
  Grid = '495173826132986745856724931729865314567419203683547102341258009274390068918600057',
  Diagonal = false,
  Regions = ''
);
/

/**
 * @test the region solver finishes the same board
 * @expect $result = '495173826132986745856724931729865314567419283683547192341258679274391568918632457'
 */
$result = CALL MICROFLOW Sudoku.ACT_SolveGrid(
  Grid = '495173826132986745856724931729865314567419203683547102341258009274390068918600057',
  Diagonal = false,
  Regions = '881111333881111333888221333886222277566222407566644407566644007555440077555400077'
);
/

/**
 * A finished jigsaw has nothing left to force, so the region solver must hand
 * it back untouched — the canary for the region index being built correctly.
 *
 * @test the region solver returns a solved jigsaw unchanged
 * @expect $result = '495173826132986745856724931729865314567419283683547192341258679274391568918632457'
 */
$result = CALL MICROFLOW Sudoku.ACT_SolveGrid(
  Grid = '495173826132986745856724931729865314567419283683547192341258679274391568918632457',
  Diagonal = false,
  Regions = '881111333881111333888221333886222277566222407566644407566644007555440077555400077'
);
/

/**
 * The generator returns the solution and its layout in one string, because the
 * two must come from the same random transform.
 *
 * @test SUB_ShuffleSolutionJ returns 162 characters
 * @expect length($result) = 162
 */
$result = CALL MICROFLOW Sudoku.SUB_ShuffleSolutionJ();
/

/**
 * @test SUB_ShuffleSolutionJ leaves no empty square in the solution half
 * @expect find(substring($result, 0, 81), '0') < 0
 */
$result = CALL MICROFLOW Sudoku.SUB_ShuffleSolutionJ();
/

-- =====================================================================
-- Sudoku Mix — two interlocking grids
-- =====================================================================
-- The generator's job is that the two grids agree on the nine squares they
-- share. These pin the overlap explicitly, because the failure is silent: a
-- flip leaves each grid individually valid while moving the shared corners
-- apart, so per-grid checks alone would pass on a broken board.
--
-- Overlap relation: A[6+i][6+j] = B[i][j] — index (6+i)*9+(6+j) in the first
-- half equals 81 + i*9 + j in the second.

/**
 * @test SUB_ShuffleSolutionMix returns 162 characters
 * @expect length($result) = 162
 */
$result = CALL MICROFLOW Sudoku.SUB_ShuffleSolutionMix();
/

/**
 * @test SUB_ShuffleSolutionMix leaves no empty square
 * @expect find($result, '0') < 0
 */
$result = CALL MICROFLOW Sudoku.SUB_ShuffleSolutionMix();
/

/**
 * Top-left of the shared block: A row 6 col 6 against B row 0 col 0.
 *
 * @test the grids agree on the first shared square
 * @expect substring($result, 60, 1) = substring($result, 81, 1)
 */
$result = CALL MICROFLOW Sudoku.SUB_ShuffleSolutionMix();
/

/**
 * Centre of the shared block: A row 7 col 7 against B row 1 col 1.
 *
 * @test the grids agree on the centre shared square
 * @expect substring($result, 70, 1) = substring($result, 91, 1)
 */
$result = CALL MICROFLOW Sudoku.SUB_ShuffleSolutionMix();
/

/**
 * Bottom-right of the shared block: A row 8 col 8 against B row 2 col 2.
 *
 * @test the grids agree on the last shared square
 * @expect substring($result, 80, 1) = substring($result, 101, 1)
 */
$result = CALL MICROFLOW Sudoku.SUB_ShuffleSolutionMix();
/

-- =====================================================================
-- Coverage added after measuring the suite by mutation testing
-- =====================================================================
-- Every assertion below is `$result = '<literal>'`, the one shape that
-- evaluates correctly on both sides of ako/mxcli PR 151. Helpers in
-- 09-test-helpers.mdl fold side effects into that shape.
-- =====================================================================

/**
 * The validator has to be able to say no, or it is the same trap as an
 * assertion that cannot fail. 81 ones is a complete 81-character grid with
 * no empty square — everything the old generator tests checked — and it
 * duplicates a digit in the very first row.
 *
 * @test the grid validator rejects an invalid grid
 * @expect $result = 'row 0'
 */
$result = CALL MICROFLOW Sudoku.SUB_ValidateGrid(
  Grid = '111111111111111111111111111111111111111111111111111111111111111111111111111111111',
  Diagonal = false,
  Regions = ''
);
/

/**
 * A valid classic grid that breaks only the diagonal rule must pass as a
 * classic and fail as a Sudoku X, or the Diagonal flag is doing nothing.
 *
 * @test the validator accepts a classic grid
 * @expect $result = 'OK'
 */
$result = CALL MICROFLOW Sudoku.SUB_ValidateGrid(
  Grid = '534678912672195348198342567859761423426853791713924856961537284287419635345286179',
  Diagonal = false,
  Regions = ''
);
/

/**
 * @test the validator applies the diagonal rule only when asked
 * @expect $result = 'diag 0'
 */
$result = CALL MICROFLOW Sudoku.SUB_ValidateGrid(
  Grid = '534678912672195348198342567859761423426853791713924856961537284287419635345286179',
  Diagonal = true,
  Regions = ''
);
/

/**
 * @test the validator rejects a region map that is not a partition
 * @expect $result = 'unit 0 size 8'
 */
$result = CALL MICROFLOW Sudoku.SUB_ValidateGrid(
  Grid = '534678912672195348198342567859761423426853791713924856961537284287419635345286179',
  Diagonal = false,
  Regions = '100111222000111222000111222333444555333444555333444555666777888666777888666777888'
);
/

/**
 * The generators are the highest-risk code here — random transforms with no
 * fixed expected output — and were covered only by "81 characters, no zero".
 * A generator returning 81 ones satisfied that, and did.
 *
 * @test the classic generator produces a valid grid
 * @expect $result = 'OK'
 */
$result = CALL MICROFLOW Sudoku.TST_GenClassicValid();
/

/**
 * @test the Sudoku X generator produces a grid valid on both diagonals
 * @expect $result = 'OK'
 */
$result = CALL MICROFLOW Sudoku.TST_GenDiagonalValid();
/

/**
 * @test the jigsaw generator produces a grid valid against its own region map
 * @expect $result = 'OK'
 */
$result = CALL MICROFLOW Sudoku.TST_GenJigsawValid();
/

/**
 * Checks both grids and all nine shared squares, not the three the old
 * tests sampled. This is the assertion that catches a transform leaving
 * each grid individually valid while pulling the overlap apart.
 *
 * @test the Mix generator produces two valid grids that agree on the overlap
 * @expect $result = 'OK'
 */
$result = CALL MICROFLOW Sudoku.TST_GenMixValid();
/

/**
 * The property the "exactly one solution" claim rests on. A repair pass
 * that returned its input unrepaired passed the whole suite before.
 *
 * @test a repaired puzzle solves back to the grid it came from
 * @expect $result = 'OK'
 */
$result = CALL MICROFLOW Sudoku.TST_RepairSolvesBack();
/

/**
 * The move layer had no test at all. A board where every key wrote the
 * digit 5 passed 22/22.
 *
 * These assert on the board the helper returns rather than on a summary
 * string it builds. Before `@expect` could evaluate expressions the only
 * readable shape was one folded literal, which reported a whole board when
 * a single field was wrong; now a failure names the field and shows the
 * value that came back.
 *
 * @test playing the right digit lands that digit in the selected square
 * @expect $result/Sudoku.Game_SelectedCell/Value = 5
 */
$result = CALL MICROFLOW Sudoku.TST_Play(Digit = 5);
/

/**
 * @test playing the right digit raises no conflict and advances the counters
 * @expect $result/FilledCount = 41 and $result/ErrorCount = 0 and $result/EmptyCount = 40
 */
$result = CALL MICROFLOW Sudoku.TST_Play(Digit = 5);
/

/**
 * The answer at that square is 5, so 3 must land and be counted wrong —
 * the board records the move rather than rejecting it.
 *
 * @test playing a wrong digit lands it and is counted as a conflict
 * @expect $result/Sudoku.Game_SelectedCell/Value = 3 and $result/ErrorCount = 1
 */
$result = CALL MICROFLOW Sudoku.TST_Play(Digit = 3);
/

/**
 * @test undo removes the digit, restores the counters and empties the history
 * @expect $result/Sudoku.Game_SelectedCell/Value = empty and $result/EmptyCount = 41 and $result/CanUndo = false
 */
$result = CALL MICROFLOW Sudoku.TST_PlayThen(Action = 'undo');
/

/**
 * @test redo puts it back
 * @expect $result/Sudoku.Game_SelectedCell/Value = 5 and $result/EmptyCount = 40 and $result/CanUndo
 */
$result = CALL MICROFLOW Sudoku.TST_PlayThen(Action = 'redo');
/

/**
 * Erase clears the square but is itself a move, so it stays undoable.
 *
 * @test erase clears the selected square and remains undoable
 * @expect $result/Sudoku.Game_SelectedCell/Value = empty and $result/EmptyCount = 41 and $result/CanUndo
 */
$result = CALL MICROFLOW Sudoku.TST_PlayThen(Action = 'erase');
/

/**
 * Reset drops the undo history as well as the digits — the bug in
 * FINDINGS #43 was undo resurrecting a value reset had just erased.
 *
 * @test reset clears the board and drops the undo history
 * @expect $result/EmptyCount = 41 and $result/FilledCount = 40 and $result/CanUndo = false
 */
$result = CALL MICROFLOW Sudoku.TST_PlayThen(Action = 'reset');
/

/**
 * ACT_Refresh assumed 81 squares, which is false for the Mix and shipped as
 * a negative empty count. This board has 100 playable squares and 20 with
 * no solution, so a hardcoded 81 cannot produce the right answer.
 *
 * @test the empty count follows the board size, not a constant 81
 * @expect $result/EmptyCount = 100 and $result/FilledCount = 0
 */
$result = CALL MICROFLOW Sudoku.TST_RefreshCounters();
/

/**
 * ACT_Hint was untested. It reveals one square and charges a hint for it.
 *
 * @test a hint reveals exactly one square and is counted
 * @expect $result/HintCount = 1 and $result/FilledCount = 41 and $result/EmptyCount = 40 and $result/ErrorCount = 0
 */
$result = CALL MICROFLOW Sudoku.TST_Hint();
/

/**
 * In notes mode a digit must leave a pencil mark and NOT an answer. Both
 * halves matter: a notes mode that also wrote the answer would look right
 * on screen until the conflict counter moved.
 *
 * @test in notes mode a digit marks a candidate instead of answering
 * @expect $result/Sudoku.Game_SelectedCell/N5 and $result/Sudoku.Game_SelectedCell/Value = empty
 */
$result = CALL MICROFLOW Sudoku.TST_NoteMark();
/

/**
 * @test notes mode leaves the board counters untouched
 * @expect $result/FilledCount = 40 and $result/EmptyCount = 41
 */
$result = CALL MICROFLOW Sudoku.TST_NoteMark();
/

/**
 * ACT_DealGame turns a generated grid into 81 rows, and that step had no
 * test: the generators were checked, the transcription was not. Each square
 * is read back at the index its own Row and Col claim, so a deal that wrote
 * a square to the wrong coordinates fails here.
 *
 * @test a dealt classic board transcribes to a valid grid
 * @expect $result = 'OK'
 */
$result = CALL MICROFLOW Sudoku.TST_DealValid(Variant = Sudoku.Variant.Classic);
/

/**
 * @test a dealt Sudoku X board is valid on both diagonals too
 * @expect $result = 'OK'
 */
$result = CALL MICROFLOW Sudoku.TST_DealValid(Variant = Sudoku.Variant.Diagonal);
/
