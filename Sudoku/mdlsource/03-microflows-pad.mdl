-- =====================================================================
-- Sudoku — number-pad actions
-- =====================================================================
-- A Mendix button can only map object parameters from the page context,
-- not literals, so each digit gets a thin wrapper. All of them delegate
-- to ACT_ApplyValue, which holds the single copy of the move logic.
-- =====================================================================

/**
 * Number-pad action: writes 1 into the selected square.
 *
 * @param $Cell The square currently selected on the board
 * @returns True when the move was applied
 */
create or replace microflow Sudoku.ACT_Set1 (
  $Cell: Sudoku."Cell"
)
returns boolean as $Applied
folder 'Moves'
begin
  $Applied = call microflow Sudoku.ACT_ApplyValue(Cell = $Cell, Digit = 1);
  return $Applied;
end;
/

