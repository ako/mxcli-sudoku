-- =====================================================================
-- Sudoku — domain model
-- =====================================================================
-- A Game holds one puzzle; 81 Cell objects hold the board. Each Cell
-- stores both the player's Value and the SolutionValue, so validating a
-- move is a straight comparison (no row/column/box scanning needed).
--
-- Re-runnable, and the choice of form per statement is the whole point.
-- `create module` is already a no-op against an existing project. The
-- association uses `create ... if not exists`, as do the entities. The
-- enumerations use `create or modify`, which reports
-- "Unchanged" and is safe because this file defines them completely. The two
-- entities use `create entity if not exists`, which leaves an existing entity
-- untouched.
--
-- Do NOT reach for `create or modify` on the entities. It replaces the WHOLE
-- definition and drops any member the statement omits (FINDINGS #24), and
-- 02-domain-refinements.mdl adds attributes to both Game and Cell after this
-- file runs — Variant, NotesMode, the per-digit remainders, the selection
-- flags. It would silently delete every one of them. Measured: with the
-- refinements applied, Game carries 28 attributes, and `if not exists` leaves
-- all 28 alone.
--
-- The mirror-image trap applies to the enumerations. `create or modify` is
-- right here only while this file remains the single place values are
-- defined; a value added by a delta script would be deleted on the next run.
-- Add values HERE, or with `alter enumeration ... add value if not exists`
-- once that lands (ako/mxcli PR 397) — never with a bare `create` elsewhere.
-- =====================================================================

create module Sudoku;
/

/**
 * Puzzle difficulty — drives how many cells are revealed at deal time.
 */
/**
 * Which rule set a game is played under.
 *
 * Classic is rows + columns + boxes. Diagonal adds both main diagonals
 * (a "Sudoku X"), which constrains the board hard enough that it stays
 * forced-solvable on noticeably fewer givens. Jigsaw keeps rows and columns
 * and replaces the nine boxes with nine irregular connected regions.
 *
 * Mix is not a rule change but a shape change: two classic 9x9 grids laid on
 * one 15x15 canvas, the second offset six rows and six columns, so they share
 * a 3x3 block. It is the only variant whose board is not 81 squares.
 */
create or modify enumeration Sudoku."Variant" (
  Classic 'Classic',
  Diagonal 'Diagonal X',
  Jigsaw 'Jigsaw',
  Mix 'Mix'
);
/

create or modify enumeration Sudoku."Difficulty" (
  Easy 'Easy',
  Medium 'Medium',
  Hard 'Hard'
);
/

/**
 * Lifecycle of a single game.
 */
create or modify enumeration Sudoku."GameStatus" (
  Playing 'Playing',
  Solved 'Solved'
);
/

/**
 * One Sudoku game: the board metadata and running progress counters.
 */
@position(100, 100)
create entity if not exists Sudoku."Game" (
  /** Difficulty the board was dealt at */
  "Level": Sudoku."Difficulty" default Easy,
  /** Playing until every cell matches the solution */
  "Status": Sudoku."GameStatus" default Playing,
  /** When the game was dealt. An autocreateddate is always stored as
   *  'CreatedDate' — mxcli renames the declared identifier to match. */
  "CreatedDate": autocreateddate,
  /** Number of cells revealed at deal time */
  "GivenCount": integer default 0,
  /** Number of cells the player has filled in */
  "FilledCount": integer default 0,
  /** Number of filled cells that conflict with the solution */
  "ErrorCount": integer default 0,
  /** Number of hints used */
  "HintCount": integer default 0,
  /** Status line shown above the board */
  "Message": string(200)
);
/

/**
 * One square of the 9x9 board.
 *
 * Row/Col are zero-based (0..8). CellClass is precomputed at deal time so
 * the page can style the 3x3 box borders without a large inline expression.
 */
@position(400, 100)
create entity if not exists Sudoku."Cell" (
  /** Zero-based row index, 0..8 */
  "Row": integer default 0,
  /** Zero-based column index, 0..8 */
  "Col": integer default 0,
  /** The player's entry — empty when the square is blank */
  "Value": integer,
  /** The correct answer for this square */
  "SolutionValue": integer default 0,
  /** True when the square was revealed at deal time */
  "IsGiven": boolean default false,
  /** True when the player may change this square */
  "IsEditable": boolean default true,
  /** True when the current entry conflicts with the solution */
  "IsInvalid": boolean default false,
  /** Precomputed CSS classes: box borders + given/open state */
  "CellClass": string(100)
);
/

/**
 * Every Cell belongs to one Game; deleting the Game clears its board.
 */
create association if not exists Sudoku."Cell_Game"
from Sudoku."Cell" to Sudoku."Game"
type reference
delete_behavior DELETE_AND_REFERENCES;
/
