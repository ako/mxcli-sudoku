-- =====================================================================
-- Sudoku — domain refinements for the Nocturne UI
-- =====================================================================
-- The number pad needs Game-level data (how many of each digit are still
-- to place) while its keys act on the selected square. Rather than read
-- the selection from a gallery widget, the Game now *owns* the selection
-- through Game_SelectedCell. That single change lets the pad, the status
-- line and the progress bar all live in the Game's data context.
--
-- One ALTER per attribute: a single ALTER ENTITY accepts `default` only on
-- its first ADD clause.
-- =====================================================================

-- Preformatted for the header: a widget cannot apply a date pattern via
-- contentparams, so the label is built once at deal time.
alter entity Sudoku."Game"
  add attribute "DateLabel": string(40);
/

-- An `autocreateddate` becomes Mendix's SYSTEM createdDate member, which a
-- widget cannot bind (CE1613). Keep an explicit datetime for the header.
alter entity Sudoku."Game"
  add attribute "DealtAt": datetime;
/

-- Sequential puzzle number shown in the header
alter entity Sudoku."Game"
  add attribute "PuzzleNo": autonumber default 2831;
/

-- How many of each digit are still to be placed (9 minus those on the board)
alter entity Sudoku."Game"
  add attribute "Remaining1": integer default 9;
/

alter entity Sudoku."Game"
  add attribute "Remaining2": integer default 9;
/

alter entity Sudoku."Game"
  add attribute "Remaining3": integer default 9;
/

alter entity Sudoku."Game"
  add attribute "Remaining4": integer default 9;
/

alter entity Sudoku."Game"
  add attribute "Remaining5": integer default 9;
/

alter entity Sudoku."Game"
  add attribute "Remaining6": integer default 9;
/

alter entity Sudoku."Game"
  add attribute "Remaining7": integer default 9;
/

alter entity Sudoku."Game"
  add attribute "Remaining8": integer default 9;
/

alter entity Sudoku."Game"
  add attribute "Remaining9": integer default 9;
/

-- Selected-square readout, shown under the board
alter entity Sudoku."Game"
  add attribute "SelRow": integer default 0;
/

alter entity Sudoku."Game"
  add attribute "SelCol": integer default 0;
/

alter entity Sudoku."Game"
  add attribute "SelBox": integer default 0;
/

alter entity Sudoku."Game"
  add attribute "HasSelection": boolean default false;
/

-- Whether the selected square can be written to, so the pad can lock
-- itself instead of silently swallowing digits on a dealt square.
alter entity Sudoku."Game"
  add attribute "SelEditable": boolean default true;
/

-- Board progress: EmptyCount for the status line, ProgressBucket (0..20)
-- for the progress bar, which is widened by a CSS class per 5%.
alter entity Sudoku."Game"
  add attribute "EmptyCount": integer default 81;
/

alter entity Sudoku."Game"
  add attribute "ProgressBucket": integer default 0;
/

-- Set on every square holding the same digit as the selected one, so
-- selecting a filled square lights up its whole group.
alter entity Sudoku."Cell"
  add attribute "IsPeer": boolean default false;
/

-- Drives the selected-square highlight, replacing gallery selection
alter entity Sudoku."Cell"
  add attribute "IsSelected": boolean default false;
/

/**
 * The square the player currently has selected, if any.
 */
create association Sudoku."Game_SelectedCell"
from Sudoku."Game" to Sudoku."Cell"
type reference;
/

-- =====================================================================
-- Notes (pencil marks), undo/redo, and completion stats
-- =====================================================================

-- Nine candidate flags per square. Nine booleans rather than one packed
-- string because each pencil mark is its own widget with its own
-- visibility expression, and a widget cannot index into a string.
alter entity Sudoku."Cell"
  add attribute "N1": boolean default false;
/

alter entity Sudoku."Cell"
  add attribute "N2": boolean default false;
/

alter entity Sudoku."Cell"
  add attribute "N3": boolean default false;
/

alter entity Sudoku."Cell"
  add attribute "N4": boolean default false;
/

alter entity Sudoku."Cell"
  add attribute "N5": boolean default false;
/

alter entity Sudoku."Cell"
  add attribute "N6": boolean default false;
/

alter entity Sudoku."Cell"
  add attribute "N7": boolean default false;
/

alter entity Sudoku."Cell"
  add attribute "N8": boolean default false;
/

alter entity Sudoku."Cell"
  add attribute "N9": boolean default false;
/

-- Notes mode: digits write pencil marks instead of an answer
alter entity Sudoku."Game"
  add attribute "NotesMode": boolean default false;
/

-- Undo/redo cursor over the Move log. MoveSeq is where we are, MaxSeq is
-- how far the log goes; redo is possible while MoveSeq < MaxSeq.
alter entity Sudoku."Game"
  add attribute "MoveSeq": integer default 0;
/

alter entity Sudoku."Game"
  add attribute "MaxSeq": integer default 0;
/

alter entity Sudoku."Game"
  add attribute "CanUndo": boolean default false;
/

alter entity Sudoku."Game"
  add attribute "CanRedo": boolean default false;
/

-- Completion stats
alter entity Sudoku."Game"
  add attribute "SolvedAt": datetime;
/

alter entity Sudoku."Game"
  add attribute "ElapsedSeconds": integer default 0;
/

alter entity Sudoku."Game"
  add attribute "ElapsedLabel": string(60);
/

alter entity Sudoku."Game"
  add attribute "BarBucket": integer default 0;
/

/**
 * One reversible change to a square, forming the undo/redo log.
 *
 * Only answer changes are logged; pencil marks are not reversible.
 */
@position(700, 100)
create persistent entity Sudoku."Move" (
  /** Position in this game's log, 1-based */
  "Seq": integer default 0,
  /** Value before the change, empty when the square was blank */
  "OldValue": integer,
  /** Value after the change, empty when the square was cleared */
  "NewValue": integer
);
/

/**
 * The game a logged move belongs to; clearing the game clears its log.
 */
create association Sudoku."Move_Game"
from Sudoku."Move" to Sudoku."Game"
type reference
delete_behavior DELETE_AND_REFERENCES;
/

/**
 * The square a logged move changed.
 */
create association Sudoku."Move_Cell"
from Sudoku."Move" to Sudoku."Cell"
type reference
delete_behavior DELETE_AND_REFERENCES;
/
