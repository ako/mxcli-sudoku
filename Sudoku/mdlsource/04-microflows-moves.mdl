/**
 * Steps one answer change backwards.
 *
 * @param $Game The game being played
 * @returns True when a move was undone
 */
create or replace microflow Sudoku.ACT_Undo (
  $Game: Sudoku."Game"
)
returns boolean as $Undone
folder 'History'
begin
  declare $Undone boolean = false;

  if $Game = empty then
    return false;
  end if;
  if $Game/"MoveSeq" <= 0 then
    return false;
  end if;

  retrieve $Move from Sudoku."Move"
    where [Sudoku."Move_Game" = $Game and "Seq" = $Game/"MoveSeq"]
    limit 1;
  if $Move = empty then
    return false;
  end if;

  retrieve $Cell from $Move/Sudoku."Move_Cell";
  if $Cell != empty then
    change $Cell ("Value" = $Move/"OldValue", "IsInvalid" = false) refresh;
    commit $Cell refresh;
  end if;

  change $Game ("MoveSeq" = $Game/"MoveSeq" - 1, "CanRedo" = true) refresh;
  change $Game ("CanUndo" = $Game/"MoveSeq" > 0) refresh;
  commit $Game refresh;

  call microflow Sudoku.ACT_Refresh(Game = $Game);

  set $Undone = true;
  return $Undone;
end;
/

/**
 * Steps one answer change forwards again.
 *
 * @param $Game The game being played
 * @returns True when a move was redone
 */
create or replace microflow Sudoku.ACT_Redo (
  $Game: Sudoku."Game"
)
returns boolean as $Redone
folder 'History'
begin
  declare $Redone boolean = false;
  declare $target integer = 0;

  if $Game = empty then
    return false;
  end if;
  if $Game/"MoveSeq" >= $Game/"MaxSeq" then
    return false;
  end if;

  set $target = $Game/"MoveSeq" + 1;
  retrieve $Move from Sudoku."Move"
    where [Sudoku."Move_Game" = $Game and "Seq" = $target]
    limit 1;
  if $Move = empty then
    return false;
  end if;

  retrieve $Cell from $Move/Sudoku."Move_Cell";
  if $Cell != empty then
    change $Cell ("Value" = $Move/"NewValue", "IsInvalid" = false) refresh;
    commit $Cell refresh;
  end if;

  change $Game ("MoveSeq" = $Game/"MoveSeq" + 1, "CanUndo" = true) refresh;
  change $Game ("CanRedo" = $Game/"MoveSeq" < $Game/"MaxSeq") refresh;
  commit $Game refresh;

  call microflow Sudoku.ACT_Refresh(Game = $Game);

  set $Redone = true;
  return $Redone;
end;
/
