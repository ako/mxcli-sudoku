-- =====================================================================
-- Sudoku — new-game actions, landing page, board navigation
-- =====================================================================
-- Order matters: the ACT_New* microflows open Sudoku.Game_Play (already
-- created), the Home page calls those microflows, and the final ALTER
-- adds the "New game" link back to Home — so nothing forward-references.
-- =====================================================================

/**
 * Deals an easy board and opens it.
 *
 * @returns The dealt game
 */
create or replace microflow Sudoku.ACT_NewEasy ()
returns Sudoku."Game" as $Game
folder 'Game'
begin
  log info node 'Sudoku' 'ACT_NewEasy';

  $Game = call microflow Sudoku.ACT_DealGame(Level = Sudoku."Difficulty".Easy, TargetGivens = 50, Variant = Sudoku."Variant".Classic);
  show page Sudoku.Game_Play($Game = $Game);
  return $Game;
end;
/

/**
 * Deals a medium board and opens it.
 *
 * @returns The dealt game
 */
create or replace microflow Sudoku.ACT_NewMedium ()
returns Sudoku."Game" as $Game
folder 'Game'
begin
  log info node 'Sudoku' 'ACT_NewMedium';

  $Game = call microflow Sudoku.ACT_DealGame(Level = Sudoku."Difficulty".Medium, TargetGivens = 42, Variant = Sudoku."Variant".Classic);
  show page Sudoku.Game_Play($Game = $Game);
  return $Game;
end;
/

/**
 * Deals a hard board and opens it.
 *
 * @returns The dealt game
 */
create or replace microflow Sudoku.ACT_NewHard ()
returns Sudoku."Game" as $Game
folder 'Game'
begin
  log info node 'Sudoku' 'ACT_NewHard';

  $Game = call microflow Sudoku.ACT_DealGame(Level = Sudoku."Difficulty".Hard, TargetGivens = 30, Variant = Sudoku."Variant".Classic);
  show page Sudoku.Game_Play($Game = $Game);
  return $Game;
end;
/

-- =====================================================================
-- Landing page
-- =====================================================================

create or replace page Sudoku.Home
(
  title: 'Sudoku',
  layout: Atlas_Core.Atlas_Default,
  class: 'sd-page'
)
{
  container sdHomeShell (class: 'sd-shell sd-home') {

    container sdHero (class: 'sd-hero') {
      dynamictext sdHeroTitle (content: 'Sudoku', rendermode: H1, class: 'sd-hero-title')
      dynamictext sdHeroSub (
        content: 'A freshly generated board every time. Pick a difficulty to begin.',
        rendermode: Paragraph,
        class: 'sd-hero-sub'
      )
    }

    container sdCards (class: 'sd-cards') {

      container sdCardEasy (class: 'sd-card sd-card-easy') {
        dynamictext sdEasyDot (content: 'Relaxed', class: 'sd-card-kicker')
        dynamictext sdEasyName (content: 'Easy', rendermode: H2, class: 'sd-card-name')
        dynamictext sdEasyDesc (
          content: 'Around 45 of the 81 squares revealed.',
          rendermode: Paragraph,
          class: 'sd-card-desc'
        )
        actionbutton bEasy (
          caption: 'Start easy game',
          action: microflow Sudoku.ACT_NewEasy,
          buttonstyle: primary,
          class: 'sd-cta'
        )
      }

      container sdCardMedium (class: 'sd-card sd-card-medium') {
        dynamictext sdMedDot (content: 'Balanced', class: 'sd-card-kicker')
        dynamictext sdMedName (content: 'Medium', rendermode: H2, class: 'sd-card-name')
        dynamictext sdMedDesc (
          content: 'Around 35 squares to start you off.',
          rendermode: Paragraph,
          class: 'sd-card-desc'
        )
        actionbutton bMedium (
          caption: 'Start medium game',
          action: microflow Sudoku.ACT_NewMedium,
          buttonstyle: primary,
          class: 'sd-cta'
        )
      }

      container sdCardHard (class: 'sd-card sd-card-hard') {
        dynamictext sdHardDot (content: 'Demanding', class: 'sd-card-kicker')
        dynamictext sdHardName (content: 'Hard', rendermode: H2, class: 'sd-card-name')
        dynamictext sdHardDesc (
          content: 'Around 28 squares. Bring patience.',
          rendermode: Paragraph,
          class: 'sd-card-desc'
        )
        actionbutton bHard (
          caption: 'Start hard game',
          action: microflow Sudoku.ACT_NewHard,
          buttonstyle: primary,
          class: 'sd-cta'
        )
      }
    }

  container sdCardsX (class: 'sd-cards sd-cards-x') {
    container sdCardDiag (class: 'sd-card sd-card-diag') {
      dynamictext sdDiagDot (content: 'Variant', class: 'sd-card-kicker')
      dynamictext sdDiagName (content: 'Diagonal X', rendermode: H2, class: 'sd-card-name')
      dynamictext sdDiagDesc (
        content: 'Both marked diagonals must also hold 1 to 9 once. Fewer givens, same difficulty.',
        rendermode: Paragraph,
        class: 'sd-card-desc'
      )
      actionbutton bDiagonal (
        caption: 'Start diagonal game',
        action: microflow Sudoku.ACT_NewDiagonal,
        buttonstyle: primary,
        class: 'sd-cta'
      )
    }

    container sdCardJig (class: 'sd-card sd-card-jig') {
      dynamictext sdJigDot (content: 'Variant', class: 'sd-card-kicker')
      dynamictext sdJigName (content: 'Jigsaw', rendermode: H2, class: 'sd-card-name')
      dynamictext sdJigDesc (
        content: 'The nine boxes become nine irregular shapes. Rows and columns are unchanged.',
        rendermode: Paragraph,
        class: 'sd-card-desc'
      )
      actionbutton bJigsaw (
        caption: 'Start jigsaw game',
        action: microflow Sudoku.ACT_NewJigsaw,
        buttonstyle: primary,
        class: 'sd-cta'
      )
    }
  }

    container sdHomeFoot (class: 'sd-home-foot') {
      dynamictext sdFootText (
        content: 'Select a square on the board, then tap a number to fill it in.',
        rendermode: Paragraph,
        class: 'sd-foot-text'
      )
    }
  }
}
/

/**
 * Deals a jigsaw ("vorm") sudoku: rows and columns as usual, but the nine
 * 3x3 boxes are replaced by nine irregular connected regions.
 *
 * Dealt at 40 givens. A jigsaw's regions are less regular than boxes, which
 * makes forced logic reach further in some places and stall sooner in others,
 * so it sits between Easy and the Sudoku X rather than following either.
 *
 * @returns The dealt game
 */
create or replace microflow Sudoku.ACT_NewJigsaw ()
returns Sudoku."Game" as $Game
folder 'Game'
begin
  log info node 'Sudoku' 'ACT_NewJigsaw';

  $Game = call microflow Sudoku.ACT_DealGame(
    Level = Sudoku."Difficulty".Medium,
    TargetGivens = 40,
    Variant = Sudoku."Variant".Jigsaw);

  show page Sudoku.Game_Play($Game = $Game);
  return $Game;
end;
/

grant execute on microflow Sudoku.ACT_NewJigsaw to Sudoku.User;
/

-- The completion page cannot reference Sudoku.Home at creation time (it is
-- built before the landing page), so its actions are appended here.
alter page Sudoku.Game_Done {
  insert after sdDoneChartWrap {
    container sdDoneActions (class: 'sd-done-actions') {
      container doneNew (class: 'sd-tool sd-tool-on', OnClick: show_page Sudoku.Home) {
        dynamictext doneNewT (content: 'NEW PUZZLE', class: 'sd-tool-text')
      }
    }
  }
};
/

/**
 * Deals a Sudoku X: the classic rules plus both main diagonals.
 *
 * The extra two units constrain the board hard, so a diagonal board stays
 * forced-solvable on noticeably fewer givens than a classic one — 36 here
 * against Easy's 50. Dealing it at 50 would leave almost nothing to do.
 *
 * @returns The dealt game
 */
create or replace microflow Sudoku.ACT_NewDiagonal ()
returns Sudoku."Game" as $Game
folder 'Game'
begin
  log info node 'Sudoku' 'ACT_NewDiagonal';

  $Game = call microflow Sudoku.ACT_DealGame(
    Level = Sudoku."Difficulty".Medium,
    TargetGivens = 36,
    Variant = Sudoku."Variant".Diagonal);

  show page Sudoku.Game_Play($Game = $Game);
  return $Game;
end;
/

grant execute on microflow Sudoku.ACT_NewDiagonal to Sudoku.User;
/

-- A fourth card, set apart from the three difficulty tiers because it changes
-- the rules rather than the number of givens.